# Curriculum Flight Simulator — copy to .env. Never commit .env.
CFS_ENV=development
# local_single_user (development only; refused in production) | oidc
CFS_AUTH_MODE=local_single_user
# Required in production (>= 32 random chars); signs short-lived job stream tokens
# CFS_SECRET_KEY=
# OIDC (Cognito or institutional IdP)
# CFS_OIDC_ISSUER=https://cognito-idp.ca-central-1.amazonaws.com/<pool-id>
# CFS_OIDC_AUDIENCE=<app-client-id>
# CFS_OIDC_GROUPS_CLAIM=cognito:groups
# Webpage import: allowed domain suffixes (empty = any public host)
CFS_FETCH_ALLOWED_DOMAINS=ucalgary.ca
# Host-side ports (Compose maps db→5433, redis→6380 to avoid clashing with local services)
CFS_DATABASE_URL=postgresql+psycopg://cfs:cfs@localhost:5433/cfs
CFS_BROKER_URL=redis://localhost:6380/0
CFS_STORAGE_BACKEND=local
CFS_STORAGE_ROOT=./data/objects
# CFS_S3_BUCKET=
# CFS_S3_REGION=ca-central-1

# Model providers. Configuring a key means selected excerpts of assigned documents WILL be sent to that
# provider for the routes that use it. Leave blank to run with AI disabled (the rest of the app still works).
CFS_OPENAI_API_KEY=
CFS_ANTHROPIC_API_KEY=
# Providers workspace content may be sent to (remove one to disable it everywhere)
CFS_AI_PROVIDER_ALLOWLIST=openai,anthropic
# Spending controls (USD)
CFS_AI_MONTHLY_BUDGET_USD=50
CFS_AI_MAX_COST_PER_JOB_USD=2
CFS_AI_EMBEDDINGS_ENABLED=true
# Optional overrides (JSON). Routes: classify, extract, synthesize, pedagogy, critique, embed
# CFS_AI_ROUTES_JSON={"extract": {"provider": "anthropic", "model": "claude-sonnet-5", "fallback": null}}
# CFS_AI_PRICES_JSON={"gpt-6-sol": {"input": 2.0, "cached_input": 0.2, "output": 10.0}}
