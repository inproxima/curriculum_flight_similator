# Single-service image for hosting the prototype on Render (see docs/deployment.md, "Public prototype on Render").
# One process serves the API and the built web app on one origin and runs background jobs in-process, so the
# only other piece is PostgreSQL (which also holds uploaded originals). Local development still uses Compose.

FROM node:24-alpine AS web
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
RUN corepack enable
WORKDIR /web
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/web/ ./
RUN pnpm build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/venv PATH=/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr ocrmypdf ghostscript curl \
    && rm -rf /var/lib/apt/lists/*
# uv from PyPI rather than ghcr.io: one registry fewer for the build to reach.
RUN pip install --no-cache-dir "uv>=0.8,<0.9"
WORKDIR /app
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/api/cfs ./cfs
COPY services/api/alembic ./alembic
COPY services/api/alembic.ini ./alembic.ini
COPY fixtures /fixtures
COPY --from=web /web/dist /app/web
ENV PYTHONPATH=/app CFS_FIXTURES_DIR=/fixtures/synthetic \
    CFS_WEB_DIST_DIR=/app/web CFS_JOB_RUNNER=thread CFS_STORAGE_BACKEND=db CFS_BIND_HOST=0.0.0.0
RUN useradd --system --uid 10001 --home /app app
USER app
EXPOSE 10000
# Render sets PORT. One process, so the in-process job pool (CFS_JOB_THREADS) is the whole job capacity.
# CFS_DELETE_DRAFT_VERSIONS (comma-separated ids) removes those draft versions at start (cfs.ops.delete_version); a
# refusal is logged and never keeps the app from starting.
CMD ["sh", "-c", "alembic upgrade head && (python -m cfs.ops.delete_version --from-env || true) && exec uvicorn cfs.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --proxy-headers --forwarded-allow-ips '*'"]
