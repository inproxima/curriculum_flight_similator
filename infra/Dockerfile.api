# API and worker image (same code; the command differs). Used locally by Docker Compose and in AWS ECS.
FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/venv PATH=/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr ocrmypdf ghostscript curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /bin/uv
WORKDIR /app
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/api/cfs ./cfs
COPY services/api/alembic ./alembic
COPY services/api/alembic.ini ./alembic.ini
COPY services/worker/cfs_worker ./cfs_worker
COPY fixtures /fixtures
ENV PYTHONPATH=/app CFS_FIXTURES_DIR=/fixtures/synthetic
RUN useradd --system --uid 10001 --home /app app && mkdir -p /data/objects && chown -R app /data
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -fsS http://127.0.0.1:8000/api/v1/health || exit 1
# Production: several workers, trust X-Forwarded-* from the load balancer. Compose overrides this for --reload.
CMD ["uvicorn", "cfs.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
# Worker:     celery -A cfs_worker.app worker --loglevel=INFO --concurrency=2 --without-heartbeat --without-mingle --without-gossip
# Migrations: alembic upgrade head
